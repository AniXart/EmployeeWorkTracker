<Window x:Class="EmployeeWorkTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:EmployeeWorkTracker.ViewModels"
        Title="Work Tracker"
        Width="1280" Height="800"
        MinWidth="1024" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A0A0A0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="64"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="Transparent" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#252525"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#1A1A1A" BorderBrush="#3E3E3E" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#222222" BorderBrush="#3E3E3E" BorderThickness="0,0,1,0">
                <StackPanel VerticalAlignment="Top" Margin="0,16,0,0">
                    <Button Style="{StaticResource SidebarButton}" Command="{Binding OpenMainMenuCommand}" ToolTip="{DynamicResource HomeTooltip}">
                        <materialDesign:PackIcon Kind="Home" Width="24" Height="24"/>
                    </Button>
                    <Button Style="{StaticResource SidebarButton}" Command="{Binding OpenDatabaseCommand}" ToolTip="{DynamicResource EmployeesTooltip}">
                        <materialDesign:PackIcon Kind="AccountGroup" Width="24" Height="24"/>
                    </Button>
                    <Button Style="{StaticResource SidebarButton}" Command="{Binding OpenDatabaseCommand}" ToolTip="{DynamicResource DatabaseTooltip}">
                        <materialDesign:PackIcon Kind="Database" Width="24" Height="24"/>
                    </Button>
                    <Button Style="{StaticResource SidebarButton}" Command="{Binding OpenSalaryPaymentCommand}" ToolTip="{DynamicResource SalaryTooltip}">
                        <materialDesign:PackIcon Kind="Cash" Width="24" Height="24"/>
                    </Button>
                    <Button Style="{StaticResource SidebarButton}" Command="{Binding OpenReportsCommand}" ToolTip="{DynamicResource ReportsTooltip}">
                        <materialDesign:PackIcon Kind="ChartBar" Width="24" Height="24"/>
                    </Button>
                    <Button Style="{StaticResource SidebarButton}" Command="{Binding OpenSettingsCommand}" ToolTip="{DynamicResource SettingsTooltip}">
                        <materialDesign:PackIcon Kind="Cog" Width="24" Height="24"/>
                    </Button>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="24"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#1A1A1A" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <materialDesign:PackIcon Kind="ClockOutline" Width="18" Height="18" Foreground="#66BB9A" VerticalAlignment="Center"/>
                            <TextBlock Text="Work Tracker" FontSize="13" FontWeight="Medium" Foreground="#E8E8E8" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Width="48" Height="48" Click="MinimizeButton_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" Background="Transparent">
                                            <materialDesign:PackIcon Kind="Minus" Width="14" Height="14" Foreground="#A0A0A0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#333333"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Width="48" Height="48" Click="MaximizeButton_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" Background="Transparent">
                                            <materialDesign:PackIcon Kind="WindowMaximize" Width="14" Height="14" Foreground="#A0A0A0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#333333"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Width="48" Height="48" Click="CloseButton_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" Background="Transparent">
                                            <materialDesign:PackIcon Kind="Close" Width="14" Height="14" Foreground="#A0A0A0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#F2B8B5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <ContentControl Grid.Row="1" Content="{Binding CurrentView}"/>

                <Border Grid.Row="2" Background="#252525" BorderBrush="#3E3E3E" BorderThickness="0,1,0,0">
                    <Grid>
                        <TextBlock Text="{DynamicResource Ready}" FontSize="11" Foreground="#A0A0A0" VerticalAlignment="Center" Margin="16,0,0,0"/>
                        <TextBlock Text="v1.0.0" FontSize="11" Foreground="#A0A0A0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>