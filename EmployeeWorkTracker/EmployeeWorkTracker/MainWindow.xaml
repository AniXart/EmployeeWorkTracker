<Window x:Class="EmployeeWorkTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Work Tracker"
        Width="1200" Height="800"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="8"
                      GlassFrameThickness="0"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Border Background="#1A1A1A"
            BorderBrush="#3E3E3E"
            BorderThickness="1"
            CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="28"/>
            </Grid.RowDefinitions>

            <!-- Кастомный заголовок -->
            <Border Grid.Row="0" Background="#1A1A1A"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <materialDesign:PackIcon Kind="ClockOutline" 
                                                 Width="20" Height="20"
                                                 Foreground="#66BB9A"
                                                 VerticalAlignment="Center"/>
                        <TextBlock Text="Work Tracker" 
                                   FontSize="14" 
                                   FontWeight="Medium"
                                   Foreground="#E8E8E8"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Width="48" Height="48" Click="MinimizeButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="Transparent">
                                        <materialDesign:PackIcon Kind="Minus" Width="16" Height="16"
                                                                 Foreground="#A0A0A0"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#333333"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Width="48" Height="48" Click="MaximizeButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="Transparent">
                                        <materialDesign:PackIcon Kind="WindowMaximize" Width="16" Height="16"
                                                                 Foreground="#A0A0A0"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#333333"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Width="48" Height="48" Click="CloseButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="Transparent">
                                        <materialDesign:PackIcon Kind="Close" Width="16" Height="16"
                                                                 Foreground="#A0A0A0"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#F2B8B5"/>
                                            <Setter TargetName="border" Property="CornerRadius" Value="0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Основной контент -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Навигационная панель -->
                <Border Grid.Column="0" Background="#252525"
                        BorderBrush="#3E3E3E" BorderThickness="0,0,1,0">
                    <StackPanel VerticalAlignment="Top" Margin="0,16,0,0">
                        <Button x:Name="NavHome" Style="{StaticResource NavButtonActive}" ToolTip="Главное меню" Click="MainMenu_Click">
                            <materialDesign:PackIcon Kind="Home" Width="24" Height="24"/>
                        </Button>
                        <Button x:Name="NavEmployees" Style="{StaticResource NavButton}" ToolTip="Сотрудники" Click="Employees_Click">
                            <materialDesign:PackIcon Kind="AccountGroup" Width="24" Height="24"/>
                        </Button>
                        <Button x:Name="NavDatabase" Style="{StaticResource NavButton}" ToolTip="База данных" Click="Database_Click">
                            <materialDesign:PackIcon Kind="Database" Width="24" Height="24"/>
                        </Button>
                        <Button x:Name="NavTime" Style="{StaticResource NavButton}" ToolTip="Начисление зарплаты" Click="Salary_Click">
                            <materialDesign:PackIcon Kind="Cash" Width="24" Height="24"/>
                        </Button>
                        <Button x:Name="NavReports" Style="{StaticResource NavButton}" ToolTip="Отчёты" Click="Reports_Click">
                            <materialDesign:PackIcon Kind="ChartBar" Width="24" Height="24"/>
                        </Button>
                        <Button x:Name="NavSettings" Style="{StaticResource NavButton}" ToolTip="Настройки">
                            <materialDesign:PackIcon Kind="Cog" Width="24" Height="24"/>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Область контента -->
                <Border Grid.Column="1" Background="#1A1A1A">
                    <ContentControl Content="{Binding CurrentView}"/>
                </Border>
            </Grid>

            <!-- Строка состояния -->
            <Border Grid.Row="2" Background="#252525"
                    BorderBrush="#3E3E3E" BorderThickness="0,1,0,0">
                <Grid Margin="16,0">
                    <TextBlock Text="Готов" 
                               FontSize="11"
                               Foreground="#A0A0A0"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="v1.0.0" 
                               FontSize="11"
                               Foreground="#A0A0A0"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>