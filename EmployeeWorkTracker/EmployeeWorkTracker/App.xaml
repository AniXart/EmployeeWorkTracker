<Application x:Class="EmployeeWorkTracker.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:EmployeeWorkTracker.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Dark" PrimaryColor="Teal"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml"/>
                <ResourceDictionary Source="Themes/MaterialTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <converters:NullToVisibilityConverter x:Key="NullToVis"/>
            <converters:DateOnlyConverter x:Key="DateOnlyConverter"/>
            <converters:DecimalToStringConverter x:Key="DecimalToString"/>
            <converters:IntToStringConverter x:Key="IntToStringConverter"/>
            <converters:BytesToImageSourceConverter x:Key="BytesToImageSource"/>
            <converters:IndexOfConverter x:Key="IndexOfConverter"/>
            <converters:EnumToBoolConverter x:Key="EnumToBoolConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>