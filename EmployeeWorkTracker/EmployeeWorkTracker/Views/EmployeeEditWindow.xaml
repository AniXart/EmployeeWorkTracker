<Window x:Class="EmployeeWorkTracker.Views.EmployeeEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{Binding Title}"
        Width="900" Height="720"
        MinWidth="700" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style x:Key="EditTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#2E2E2E"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="CaretBrush" Value="#66BB9A"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="#2E2E2E" BorderBrush="#3E3E3E" BorderThickness="1" CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#66BB9A"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A0A0A0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="EditButton" TargetType="Button">
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="#252525" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#333333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#66BB9A"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="#66BB9A" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#5AAE8A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CountryComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#2E2E2E"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="BorderBrush" Value="#3E3E3E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Width" Value="95"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd" Background="#2E2E2E" BorderBrush="#3E3E3E" BorderThickness="1" CornerRadius="12" Cursor="Hand" MouseLeftButtonDown="ComboBoxBorder_MouseLeftButtonDown">
                                <Grid>
                                    <ContentPresenter x:Name="ContentSite" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                    <Path x:Name="Arrow" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#A0A0A0" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" PopupAnimation="Slide" StaysOpen="False">
                                <Border Background="#1A1A1A" BorderBrush="#3E3E3E" BorderThickness="1" CornerRadius="12" Margin="0,4,0,0" MaxHeight="300" Width="95">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#66BB9A"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#66BB9A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#E8E8E8"/>
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#3066BB9A"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#2066BB9A"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CommentCounterStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#A0A0A0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCommentAtMax}" Value="True">
                    <Setter Property="Foreground" Value="#F2B8B5"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="#1A1A1A" BorderBrush="#3E3E3E" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="64"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#1A1A1A" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                        <materialDesign:PackIcon Kind="AccountEdit" Width="18" Height="18" Foreground="#66BB9A" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Medium" Foreground="#E8E8E8" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Width="48" Height="48" Click="MinimizeButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="Transparent">
                                        <materialDesign:PackIcon Kind="Minus" Width="14" Height="14" Foreground="#A0A0A0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#333333"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Width="48" Height="48" Click="MaximizeButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="Transparent">
                                        <materialDesign:PackIcon Kind="WindowMaximize" Width="14" Height="14" Foreground="#A0A0A0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#333333"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Width="48" Height="48" Click="CloseButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="Transparent">
                                        <materialDesign:PackIcon Kind="Close" Width="14" Height="14" Foreground="#A0A0A0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#F2B8B5"/>
                                            <Setter TargetName="border" Property="CornerRadius" Value="0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="32">
                <StackPanel MaxWidth="800">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Border Width="150" Height="150" CornerRadius="75" Background="#252525">
                                <Grid>
                                    <materialDesign:PackIcon Kind="AccountCircle" Width="100" Height="100" Foreground="#555555" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" Visibility="{Binding PhotoPreview, Converter={StaticResource NullToVis}, ConverterParameter=inverted}"/>
                                    <Image Source="{Binding PhotoPreview}" Stretch="UniformToFill" Visibility="{Binding PhotoPreview, Converter={StaticResource NullToVis}}">
                                        <Image.Clip>
                                            <EllipseGeometry Center="75,75" RadiusX="75" RadiusY="75"/>
                                        </Image.Clip>
                                    </Image>
                                </Grid>
                            </Border>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                                <Button Style="{StaticResource EditButton}" Command="{Binding LoadPhotoCommand}" Width="44" Height="44" Margin="0,0,8,0" ToolTip="{DynamicResource LoadPhoto}">
                                    <materialDesign:PackIcon Kind="Upload" Width="20" Height="20"/>
                                </Button>
                                <Button Style="{StaticResource EditButton}" Command="{Binding DeletePhotoCommand}" Width="44" Height="44" Visibility="{Binding PhotoPreview, Converter={StaticResource NullToVis}}" ToolTip="{DynamicResource DeletePhoto}">
                                    <materialDesign:PackIcon Kind="Delete" Width="20" Height="20" Foreground="#F2B8B5"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Style="{StaticResource EditLabel}">
                                    <Run Text="{DynamicResource LastName}" Foreground="#A0A0A0"/>
                                    <Run Text=" *" Foreground="#F2B8B5"/>
                                </TextBlock>
                                <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditTextBox}" Height="44"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Style="{StaticResource EditLabel}">
                                    <Run Text="{DynamicResource FirstName}" Foreground="#A0A0A0"/>
                                    <Run Text=" *" Foreground="#F2B8B5"/>
                                </TextBlock>
                                <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditTextBox}" Height="44"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="{DynamicResource MiddleName}" Style="{StaticResource EditLabel}"/>
                                <TextBox Text="{Binding MiddleName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditTextBox}" Height="44"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Style="{StaticResource EditLabel}">
                                    <Run Text="{DynamicResource PassportNumber}" Foreground="#A0A0A0"/>
                                    <Run Text=" *" Foreground="#F2B8B5"/>
                                    <Run Text=" (AB123456)" Foreground="#666666"/>
                                </TextBlock>
                                <TextBox Text="{Binding PassportNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditTextBox}" Height="44" MaxLength="8" CharacterCasing="Upper"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Style="{StaticResource EditLabel}">
                                    <Run Text="{DynamicResource Phone}" Foreground="#A0A0A0"/>
                                    <Run Text=" *" Foreground="#F2B8B5"/>
                                </TextBlock>
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox Style="{StaticResource CountryComboBox}" ItemsSource="{Binding Countries}" SelectedItem="{Binding SelectedCountry}" Height="44">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Foreground="#E8E8E8" FontSize="13">
                                                    <Run Text="{Binding Code}" FontWeight="SemiBold"/>
                                                    <Run Text="{Binding DialCode}" Foreground="#A0A0A0"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBox Text="{Binding LocalPhoneNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditTextBox}" Height="44" Width="200" MaxLength="9" Margin="8,0,0,0" HorizontalContentAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource EditLabel}">
                                    <Run Text="{DynamicResource Position}" Foreground="#A0A0A0"/>
                                    <Run Text=" *" Foreground="#F2B8B5"/>
                                </TextBlock>
                                <TextBox Text="{Binding Position, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditTextBox}" Height="44"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Border Background="#252525" CornerRadius="12" Padding="24" Margin="0,24,0,0">
                        <StackPanel>
                            <TextBlock FontSize="14" FontWeight="Medium" Foreground="#E8E8E8" Margin="0,0,0,16">
                                <Run Text="{DynamicResource PaymentType}" Foreground="#E8E8E8"/>
                                <Run Text=" *" Foreground="#F2B8B5"/>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Button Style="{StaticResource EditButton}" Command="{Binding SetHourlyPaymentCommand}" Padding="20,10" Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="18" Height="18" CornerRadius="9" BorderBrush="#66BB9A" BorderThickness="2" Margin="0,0,8,0" Background="Transparent">
                                            <Border Background="#66BB9A" CornerRadius="7" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsHourlyPayment, Converter={StaticResource BoolToVis}}"/>
                                        </Border>
                                        <TextBlock Text="{DynamicResource Hourly}" Foreground="#E8E8E8"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource EditButton}" Command="{Binding SetFixedPaymentCommand}" Padding="20,10">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="18" Height="18" CornerRadius="9" BorderBrush="#66BB9A" BorderThickness="2" Margin="0,0,8,0" Background="Transparent">
                                            <Border Background="#66BB9A" CornerRadius="7" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsFixedPayment, Converter={StaticResource BoolToVis}}"/>
                                        </Border>
                                        <TextBlock Text="{DynamicResource Fixed}" Foreground="#E8E8E8"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel Visibility="{Binding IsHourlyPayment, Converter={StaticResource BoolToVis}}" Margin="0,0,0,16">
                                <TextBlock Style="{StaticResource EditLabel}">
                                    <Run Text="{DynamicResource HourlyRate}" Foreground="#A0A0A0"/>
                                    <Run Text=" *" Foreground="#F2B8B5"/>
                                </TextBlock>
                                <TextBox Text="{Binding HourlyRate, Converter={StaticResource DecimalToString}, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditTextBox}" Height="44" Width="200" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding IsFixedPayment, Converter={StaticResource BoolToVis}}" Margin="0,0,0,16">
                                <TextBlock Style="{StaticResource EditLabel}">
                                    <Run Text="{DynamicResource FixedAmount}" Foreground="#A0A0A0"/>
                                    <Run Text=" *" Foreground="#F2B8B5"/>
                                </TextBlock>
                                <TextBox Text="{Binding FixedAmount, Converter={StaticResource DecimalToString}, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditTextBox}" Height="44" Width="200" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <Border Background="#1A1A1A" CornerRadius="12" Padding="16" Margin="0,0,0,0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Comment}" FontSize="13" FontWeight="Medium" Foreground="#E8E8E8"/>
                                        <TextBlock Grid.Column="1" Text="{Binding CommentCounter}" Style="{StaticResource CommentCounterStyle}"/>
                                    </Grid>
                                    <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" Background="#2E2E2E" Foreground="#E8E8E8" CaretBrush="#66BB9A" FontSize="13" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="12" MaxLength="3000">
                                        <TextBox.Template>
                                            <ControlTemplate TargetType="TextBox">
                                                <Border x:Name="Bd" Background="#2E2E2E" BorderBrush="#3E3E3E" BorderThickness="1" CornerRadius="12">
                                                    <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsFocused" Value="True">
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#66BB9A"/>
                                                        <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </TextBox.Template>
                                    </TextBox>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding Error}" Foreground="#F2B8B5" Margin="0,20,0,0" FontSize="13" FontWeight="Medium" TextWrapping="Wrap" Visibility="{Binding Error, Converter={StaticResource NullToVis}, ConverterParameter=nonempty}"/>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="#252525" BorderBrush="#3E3E3E" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,24,0">
                    <Button Style="{StaticResource EditButton}" Command="{Binding CancelCommand}" Margin="0,0,12,0" MinWidth="120" Height="44">
                        <TextBlock Text="{DynamicResource Cancel}"/>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" MinWidth="140" Height="44">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave" Width="16" Height="16" Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource Save}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>