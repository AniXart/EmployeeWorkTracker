<Window x:Class="EmployeeWorkTracker.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Подтверждение"
        Width="420" Height="220"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Border Background="#1A1A1A" BorderBrush="#3E3E3E" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="64"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Border Grid.Row="0" Background="#1A1A1A" CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="Подтверждение" FontSize="14" FontWeight="Medium"
                               Foreground="#E8E8E8" VerticalAlignment="Center" Margin="20,0,0,0"/>
                    <Button Width="48" Height="48" HorizontalAlignment="Right"
                            Click="CloseButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="Transparent">
                                    <materialDesign:PackIcon Kind="Close" Width="14" Height="14" Foreground="#A0A0A0"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#F2B8B5"/>
                                        <Setter TargetName="border" Property="CornerRadius" Value="0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Контент -->
            <Border Grid.Row="1" Padding="24,16">
                <StackPanel>
                    <materialDesign:PackIcon Kind="AlertCircle" Width="32" Height="32"
                                             Foreground="#F2B8B5" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock Text="Вы уверены что хотите удалить сотрудника?"
                               FontSize="14" Foreground="#E8E8E8" TextAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Кнопки -->
            <Border Grid.Row="2" Background="#252525" BorderBrush="#3E3E3E" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,20,0"
                            VerticalAlignment="Center">
                    <Button Content="Отмена" Width="100" Height="40" Margin="0,0,12,0"
                            Background="#252525" Foreground="#E8E8E8" BorderThickness="1"
                            BorderBrush="#3E3E3E" FontSize="13" Cursor="Hand"
                            Click="CancelButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="12" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#333333"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="Удалить" Width="100" Height="40"
                            Background="#F2B8B5" Foreground="#000000" BorderThickness="0"
                            FontSize="13" FontWeight="Medium" Cursor="Hand"
                            Click="DeleteButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="#F2B8B5" CornerRadius="12" Padding="16,10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#E0A0A0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>