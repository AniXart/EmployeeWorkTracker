<UserControl x:Class="EmployeeWorkTracker.Views.SalaryPaymentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:EmployeeWorkTracker.ViewModels"
             xmlns:converters="clr-namespace:EmployeeWorkTracker.Converters">
    <UserControl.DataContext>
        <vm:SalaryPaymentViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:NullToVisibilityConverter x:Key="NullToVis"/>

        <Style x:Key="EditTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#2E2E2E"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="CaretBrush" Value="#66BB9A"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="#2E2E2E"
                                BorderBrush="#3E3E3E" BorderThickness="1" CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#66BB9A"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A0A0A0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="EditButton" TargetType="Button">
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="#252525"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#333333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#66BB9A"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="#66BB9A"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#5AAE8A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CommentCounterStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#A0A0A0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCommentAtMax}" Value="True">
                    <Setter Property="Foreground" Value="#F2B8B5"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32">
        <!-- ✅ ИСПРАВЛЕНО: Убрано HorizontalAlignment="Left", добавлено Center -->
        <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch">
            <TextBlock Text="Начисление зарплаты"
                       FontSize="24" FontWeight="Medium"
                       Foreground="#E8E8E8" Margin="0,0,0,24"/>

            <!-- Поиск сотрудника -->
            <Border Background="#252525" CornerRadius="12" Padding="24" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Поиск сотрудника по паспорту"
                               FontSize="14" FontWeight="Medium"
                               Foreground="#E8E8E8" Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding PassportSearch, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource EditTextBox}" Height="44"
                                 MaxLength="8" CharacterCasing="Upper"/>

                        <Button Grid.Column="2"
                                Command="{Binding SearchEmployeeCommand}"
                                Style="{StaticResource PrimaryButton}" Height="44">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Magnify" Width="16" Height="16" Margin="0,0,8,0"/>
                                <TextBlock Text="Найти"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBlock Text="{Binding SearchError}"
                               Foreground="#F2B8B5" FontSize="12"
                               Margin="0,8,0,0"/>

                    <Border Background="#1A1A1A" CornerRadius="12" Padding="16" Margin="0,16,0,0"
                            Visibility="{Binding EmployeeFound, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountCircle" Width="48" Height="48"
                                                     Foreground="#66BB9A" VerticalAlignment="Center"/>
                            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedEmployee.FullName}"
                                           FontSize="16" FontWeight="Medium"
                                           Foreground="#E8E8E8"/>
                                <TextBlock Text="{Binding SelectedEmployee.PassportNumber}"
                                           FontSize="12" Foreground="#66BB9A" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding SelectedEmployee.Position}"
                                           FontSize="12" Foreground="#A0A0A0" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Временной промежуток -->
            <Border Background="#252525" CornerRadius="12" Padding="24" Margin="0,0,0,16"
                    Visibility="{Binding EmployeeFound, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Период работы"
                               FontSize="14" FontWeight="Medium"
                               Foreground="#E8E8E8" Margin="0,0,0,12"/>
                    <!-- ✅ ИСПРАВЛЕНО: Убрана черточка "—", поля на всю ширину -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="С (дд.мм.гггг)" Style="{StaticResource EditLabel}"/>
                            <TextBox Text="{Binding DateFromText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource EditTextBox}" Height="44"
                                     MaxLength="10"
                                     PreviewTextInput="DateText_PreviewTextInput"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="По (дд.мм.гггг)" Style="{StaticResource EditLabel}"/>
                            <TextBox Text="{Binding DateToText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource EditTextBox}" Height="44"
                                     MaxLength="10"
                                     PreviewTextInput="DateText_PreviewTextInput"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Адреса работы -->
            <Border Background="#252525" CornerRadius="12" Padding="24" Margin="0,0,0,16"
                    Visibility="{Binding EmployeeFound, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Места работы"
                               FontSize="14" FontWeight="Medium"
                               Foreground="#E8E8E8" Margin="0,0,0,12"/>

                    <!-- ✅ ИСПРАВЛЕНО: Колонки равномерные, поля не сплюснуты -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBox Text="{Binding City, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource EditTextBox}" Height="44"/>
                            <TextBlock Text="Город" FontSize="10"
                                       Foreground="#666666" Margin="16,4,0,0"
                                       IsHitTestVisible="False" VerticalAlignment="Top"/>
                        </Grid>

                        <Grid Grid.Column="2">
                            <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource EditTextBox}" Height="44"/>
                            <TextBlock Text="Адрес" FontSize="10"
                                       Foreground="#666666" Margin="16,4,0,0"
                                       IsHitTestVisible="False" VerticalAlignment="Top"/>
                        </Grid>

                        <Grid Grid.Column="4">
                            <TextBox Text="{Binding WorkObject, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource EditTextBox}" Height="44"/>
                            <TextBlock Text="Объект (необязательно)" FontSize="10"
                                       Foreground="#666666" Margin="16,4,0,0"
                                       IsHitTestVisible="False" VerticalAlignment="Top"/>
                        </Grid>

                        <Button Grid.Column="6"
                                Command="{Binding AddWorkAddressCommand}"
                                Style="{StaticResource EditButton}" Height="44" Width="44"
                                Padding="0">
                            <materialDesign:PackIcon Kind="Plus" Width="20" Height="20"/>
                        </Button>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding WorkAddresses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1A1A1A" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock FontSize="13" Foreground="#E8E8E8">
                                                <Run Text="{Binding City}" FontWeight="Medium"/>
                                                <Run Text=", "/>
                                                <Run Text="{Binding Address}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Object}" FontSize="11"
                                                       Foreground="#A0A0A0" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                Command="{Binding DataContext.RemoveWorkAddressCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" BorderThickness="0"
                                                Padding="8" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                        <materialDesign:PackIcon Kind="Close" Width="14" Height="14" Foreground="#F2B8B5"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#30F2B8B5"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Фото росписки -->
            <Border Background="#252525" CornerRadius="12" Padding="24" Margin="0,0,0,16"
                    Visibility="{Binding EmployeeFound, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Фото росписки о получении денег"
                               FontSize="14" FontWeight="Medium"
                               Foreground="#E8E8E8" Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding LoadReceiptPhotoCommand}"
                                Style="{StaticResource EditButton}" FontSize="12" Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Upload" Width="14" Height="14" Margin="0,0,6,0"/>
                                <TextBlock Text="Загрузить фото"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding DeleteReceiptPhotoCommand}"
                                Style="{StaticResource EditButton}" FontSize="12" Padding="12,8" Margin="8,0,0,0"
                                Visibility="{Binding ReceiptPhoto, Converter={StaticResource NullToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Delete" Width="14" Height="14" Margin="0,0,6,0"/>
                                <TextBlock Text="Удалить"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Border Width="200" Height="150" CornerRadius="12" Background="#1A1A1A"
                            Margin="0,16,0,0" HorizontalAlignment="Left"
                            Visibility="{Binding ReceiptPhotoPreview, Converter={StaticResource NullToVis}}">
                        <Image Source="{Binding ReceiptPhotoPreview}"
                               Stretch="Uniform"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Комментарий -->
            <Border Background="#252525" CornerRadius="12" Padding="24" Margin="0,0,0,16"
                    Visibility="{Binding EmployeeFound, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Комментарий"
                                   FontSize="14" FontWeight="Medium"
                                   Foreground="#E8E8E8"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding CommentCounter}"
                                   Style="{StaticResource CommentCounterStyle}"/>
                    </Grid>

                    <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource EditTextBox}"
                             Height="100"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalContentAlignment="Top"
                             Padding="14"
                             MaxLength="3000"/>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding Error}"
                       Foreground="#F2B8B5" FontSize="13" FontWeight="Medium"
                       TextWrapping="Wrap" Margin="0,0,0,16"/>

            <Button Command="{Binding SavePaymentCommand}"
                    Style="{StaticResource PrimaryButton}" Height="48"
                    HorizontalAlignment="Left"
                    Visibility="{Binding EmployeeFound, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ContentSave" Width="18" Height="18" Margin="0,0,8,0"/>
                    <TextBlock Text="Сохранить начисление" FontSize="14"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </ScrollViewer>
</UserControl>