<Window x:Class="EmployeeWorkTracker.Views.ReportDetailView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Начисление"
        Width="700" Height="700"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Border Background="#1A1A1A" BorderBrush="#3E3E3E" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#1A1A1A" CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                        <materialDesign:PackIcon Kind="FileDocument" Width="18" Height="18"
                                                 Foreground="#66BB9A" VerticalAlignment="Center"/>
                        <TextBlock Text="Начисление" FontSize="14" FontWeight="Medium"
                                   Foreground="#E8E8E8" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Width="48" Height="48" HorizontalAlignment="Right" Click="CloseButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="Transparent">
                                    <materialDesign:PackIcon Kind="Close" Width="14" Height="14" Foreground="#A0A0A0"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#F2B8B5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24">
                <StackPanel>
                    <Border Background="#252525" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="80" Height="80" CornerRadius="40" Background="#1A1A1A">
                                <Image Source="{Binding EmployeePhotoSource}" Stretch="UniformToFill">
                                    <Image.Clip>
                                        <EllipseGeometry Center="40,40" RadiusX="40" RadiusY="40"/>
                                    </Image.Clip>
                                </Image>
                            </Border>
                            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding EmployeeName}" FontSize="18" FontWeight="Medium"
                                           Foreground="#E8E8E8"/>
                                <TextBlock Text="{Binding PassportNumber}" FontSize="13"
                                           Foreground="#66BB9A" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding Position}" FontSize="12"
                                           Foreground="#A0A0A0" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="#252525" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Период работы" FontSize="12" Foreground="#A0A0A0" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding PeriodDisplay}" FontSize="16" FontWeight="Medium"
                                       Foreground="#E8E8E8"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#252525" CornerRadius="12" Padding="20" Margin="0,0,0,16"
                            Visibility="{Binding HasWorkAddresses, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Места работы" FontSize="12" Foreground="#A0A0A0" Margin="0,0,0,12"/>
                            <ItemsControl ItemsSource="{Binding WorkAddresses}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1A1A1A" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock FontSize="13" Foreground="#E8E8E8">
                                                    <Run Text="{Binding City}" FontWeight="Medium"/>
                                                    <Run Text=", "/>
                                                    <Run Text="{Binding Address}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Object}" FontSize="11"
                                                           Foreground="#A0A0A0" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Background="#252525" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Фото росписки" FontSize="12" Foreground="#A0A0A0" VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Command="{Binding ChangeReceiptPhotoCommand}"
                                            Background="Transparent" BorderThickness="0"
                                            Padding="8,6" Cursor="Hand" Margin="0,0,8,0"
                                            ToolTip="Загрузить новое фото">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="border" Background="#66BB9A" CornerRadius="8" Padding="12,8">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="Upload" Width="16" Height="16"
                                                                                 Foreground="#000000" Margin="0,0,6,0"/>
                                                        <TextBlock Text="Загрузить" FontSize="12" FontWeight="Medium"
                                                                   Foreground="#000000" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#5AAE8A"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <Button Command="{Binding DeleteReceiptPhotoCommand}"
                                            Background="Transparent" BorderThickness="0"
                                            Padding="8,6" Cursor="Hand"
                                            ToolTip="Удалить фото">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="border" Background="#F2B8B5" CornerRadius="8" Padding="12,8">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="Delete" Width="16" Height="16"
                                                                                 Foreground="#000000" Margin="0,0,6,0"/>
                                                        <TextBlock Text="Удалить" FontSize="12" FontWeight="Medium"
                                                                   Foreground="#000000" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#E0A0A0"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Border Width="300" Height="200" CornerRadius="12" Background="#1A1A1A"
                                    HorizontalAlignment="Left"
                                    Visibility="{Binding HasReceiptPhoto, Converter={StaticResource BoolToVis}}">
                                <Image Source="{Binding ReceiptPhotoSource}" Stretch="Uniform"/>
                            </Border>

                            <Border Width="300" Height="200" CornerRadius="12" Background="#1A1A1A"
                                    HorizontalAlignment="Left"
                                    Visibility="{Binding HasReceiptPhoto, Converter={StaticResource BoolToVis}, ConverterParameter=inverted}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="ImageOff" Width="48" Height="48" Foreground="#555555"/>
                                    <TextBlock Text="Нет фото" Foreground="#666666" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Background="#252525" CornerRadius="12" Padding="20" Margin="0,0,0,16"
                            Visibility="{Binding HasComment, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Комментарий" FontSize="12" Foreground="#A0A0A0" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding Comment}" FontSize="13" Foreground="#E8E8E8"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding CreatedAtText}" FontSize="11" Foreground="#666666"
                               HorizontalAlignment="Right" Margin="0,16,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>