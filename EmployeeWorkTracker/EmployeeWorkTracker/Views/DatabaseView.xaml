<UserControl x:Class="EmployeeWorkTracker.Views.DatabaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:EmployeeWorkTracker.ViewModels">

    <UserControl.DataContext>
        <vm:DatabaseViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и кнопка добавления -->
        <Grid Grid.Row="0" Margin="32,24,32,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="База данных сотрудников"
                       FontSize="24"
                       FontWeight="Medium"
                       Foreground="#E8E8E8"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="1"
                    Command="{Binding AddEmployeeCommand}"
                    Cursor="Hand"
                    Height="44"
                    Padding="20,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="#66BB9A" CornerRadius="12" Padding="20,12">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="Plus" Width="16" Height="16"
                                                         Foreground="#000000" Margin="0,0,8,0"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Добавить сотрудника"
                                           FontSize="14"
                                           FontWeight="Medium"
                                           Foreground="#000000"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#5AAE8A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- Поле поиска -->
        <Border Grid.Row="1" Margin="32,0,32,16">
            <Border Background="#252525" CornerRadius="12" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <materialDesign:PackIcon Kind="Magnify"
                                             Width="20" Height="20"
                                             Foreground="#A0A0A0"
                                             VerticalAlignment="Center"/>

                    <TextBox Grid.Column="1"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="#E8E8E8"
                             FontSize="14"
                             Margin="12,0,0,0"
                             VerticalContentAlignment="Center"/>
                </Grid>
            </Border>
        </Border>

        <!-- Список сотрудников -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="32,0">
            <ItemsControl ItemsSource="{Binding FilteredEmployees}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#252525"
                                CornerRadius="12"
                                Padding="20"
                                Width="320"
                                Height="160"
                                Margin="0,0,16,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Имя -->
                                <TextBlock Grid.Row="0"
                                           Text="{Binding FullName}"
                                           FontSize="16"
                                           FontWeight="Medium"
                                           Foreground="#E8E8E8"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,0,8"/>

                                <!-- Паспорт -->
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding PassportNumber}"
                                               FontSize="12"
                                               Foreground="#66BB9A"
                                               Cursor="Hand"
                                               MouseLeftButtonUp="PassportText_MouseLeftButtonUp"
                                               Tag="{Binding}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="TextDecorations" Value="Underline"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <Border Background="#66BB9A"
                                            CornerRadius="6"
                                            Padding="6,3"
                                            Margin="8,0,0,0"
                                            Visibility="{Binding DataContext.ShowCopyNotification, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Скопировано"
                                                   FontSize="10"
                                                   Foreground="#000000"
                                                   FontWeight="Medium"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>

                                <!-- Должность -->
                                <TextBlock Grid.Row="2"
                                           Text="{Binding Position}"
                                           FontSize="13"
                                           Foreground="#A0A0A0"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,0,2"/>

                                <!-- Телефон -->
                                <TextBlock Grid.Row="3"
                                           Text="{Binding PhoneNumber}"
                                           FontSize="12"
                                           Foreground="#666666"
                                           VerticalAlignment="Bottom"/>

                                <!-- Кнопки действий -->
                                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Command="{Binding DataContext.EditEmployeeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="8"
                                            Cursor="Hand"
                                            ToolTip="Редактировать">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="border" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                    <materialDesign:PackIcon Kind="Pencil" Width="16" Height="16" Foreground="#A0A0A0"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#3066BB9A"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <Button Command="{Binding DataContext.DeleteEmployeeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="8"
                                            Cursor="Hand"
                                            ToolTip="Удалить">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="border" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                    <materialDesign:PackIcon Kind="Delete" Width="16" Height="16" Foreground="#F2B8B5"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#30F2B8B5"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>