<UserControl x:Class="EmployeeWorkTracker.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:EmployeeWorkTracker.ViewModels">
    <UserControl.DataContext>
        <vm:ReportsViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:NullToVisibilityConverter x:Key="NullToVis" xmlns:converters="clr-namespace:EmployeeWorkTracker.Converters"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource Reports}" FontSize="24" FontWeight="Medium" Foreground="#E8E8E8" Margin="32,24,32,16"/>

        <Border Grid.Row="1" Background="#252525" CornerRadius="12" Padding="20" Margin="32,0,32,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource SearchByPassportShort}" FontSize="11" Foreground="#A0A0A0" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding PassportSearch, UpdateSourceTrigger=PropertyChanged}" Background="#2E2E2E" Foreground="#E8E8E8" FontSize="13" Padding="14,10" VerticalContentAlignment="Center">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <Border x:Name="Bd" Background="#2E2E2E" BorderBrush="#3E3E3E" BorderThickness="1" CornerRadius="12">
                                    <ScrollViewer x:Name="PART_ContentHost" Margin="14,10"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsFocused" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#66BB9A"/>
                                        <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="{DynamicResource SearchByDate}" FontSize="11" Foreground="#A0A0A0" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding DateSearch, UpdateSourceTrigger=PropertyChanged}" Background="#2E2E2E" Foreground="#E8E8E8" FontSize="13" Padding="14,10" VerticalContentAlignment="Center">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <Border x:Name="Bd" Background="#2E2E2E" BorderBrush="#3E3E3E" BorderThickness="1" CornerRadius="12">
                                    <ScrollViewer x:Name="PART_ContentHost" Margin="14,10"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsFocused" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#66BB9A"/>
                                        <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                </StackPanel>

                <Button Grid.Column="4" Command="{Binding ClearSearchCommand}" VerticalAlignment="Bottom" Height="40" Background="#F2B8B5" BorderThickness="0" Padding="16,10" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="#F2B8B5" CornerRadius="12" Padding="16,10">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Foreground="#000000" Margin="0,0,6,0"/>
                                    <TextBlock Text="{DynamicResource ClearSearch}" FontSize="13" FontWeight="Medium" Foreground="#000000" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#E0A0A0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="32,0">
            <ItemsControl ItemsSource="{Binding FilteredPayments}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#252525" CornerRadius="12" Padding="24" Margin="0,0,0,16" Cursor="Hand" MouseLeftButtonUp="PaymentCard_MouseLeftButtonUp" Tag="{Binding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="80" Height="80" CornerRadius="40" Background="#1A1A1A" Margin="0,0,16,0" VerticalAlignment="Top">
                                    <Image Source="{Binding EmployeePhotoSource, Mode=OneWay}" Stretch="UniformToFill">
                                        <Image.Clip>
                                            <EllipseGeometry Center="40,40" RadiusX="40" RadiusY="40"/>
                                        </Image.Clip>
                                    </Image>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding EmployeeName, Mode=OneWay}" FontSize="16" FontWeight="Medium" Foreground="#E8E8E8" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding PassportNumber, Mode=OneWay}" FontSize="12" Foreground="#66BB9A" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding PeriodDisplay, Mode=OneWay}" FontSize="13" Foreground="#A0A0A0"/>
                                </StackPanel>

                                <Border Grid.Column="2" Width="100" Height="80" CornerRadius="8" Background="#1A1A1A" VerticalAlignment="Top" Margin="0,0,16,0">
                                    <Grid>
                                        <Image Source="{Binding ReceiptPhotoSource, Mode=OneWay}" Stretch="Uniform"
                                               Visibility="{Binding ReceiptPhotoSource, Converter={StaticResource NullToVis}}"/>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Visibility="{Binding ReceiptPhotoSource, Converter={StaticResource NullToVis}, ConverterParameter=inverted}">
                                            <materialDesign:PackIcon Kind="ImageOff" Width="24" Height="24" Foreground="#555555" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource NoPhoto}" FontSize="9" Foreground="#666666" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Button Grid.Column="3" Command="{Binding DataContext.DeletePaymentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="8" Cursor="Hand" ToolTip="{DynamicResource DeletePayment}" VerticalAlignment="Top">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <materialDesign:PackIcon Kind="Delete" Width="18" Height="18" Foreground="#F2B8B5"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#30F2B8B5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>