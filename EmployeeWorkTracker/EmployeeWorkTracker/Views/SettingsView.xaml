<UserControl x:Class="EmployeeWorkTracker.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:EmployeeWorkTracker.ViewModels"
             xmlns:services="clr-namespace:EmployeeWorkTracker.Services">
    <UserControl.DataContext>
        <vm:SettingsViewModel/>
    </UserControl.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32">
        <StackPanel MaxWidth="600" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                <materialDesign:PackIcon Kind="Cog" Width="28" Height="28" Foreground="#66BB9A" VerticalAlignment="Center"/>
                <TextBlock Text="{DynamicResource Settings}" FontSize="24" FontWeight="Medium"
                           Foreground="#E8E8E8" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <Border Background="#252525" CornerRadius="12" Padding="24" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Language}" FontSize="16" FontWeight="Medium"
                               Foreground="#E8E8E8" Margin="0,0,0,8"/>
                    <TextBlock Text="{DynamicResource SelectLanguage}" FontSize="12"
                               Foreground="#A0A0A0" Margin="0,0,0,16"/>

                    <RadioButton Content="{DynamicResource LangRussian}"
                                 IsChecked="{Binding SelectedLanguage, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static services:AppLanguage.Russian}}"
                                 Foreground="#E8E8E8" FontSize="14" Margin="0,0,0,12" Cursor="Hand">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="OuterCircle" Width="20" Height="20" CornerRadius="10"
                                            BorderBrush="#66BB9A" BorderThickness="2" Background="Transparent">
                                        <Border x:Name="InnerCircle" Width="12" Height="12" CornerRadius="6"
                                                Background="#66BB9A" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="Collapsed"/>
                                    </Border>
                                    <TextBlock Text="{TemplateBinding Content}" Foreground="#E8E8E8" FontSize="14"
                                               Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="InnerCircle" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="OuterCircle" Property="Background" Value="#2066BB9A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>

                    <RadioButton Content="{DynamicResource LangUkrainian}"
                                 IsChecked="{Binding SelectedLanguage, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static services:AppLanguage.Ukrainian}}"
                                 Foreground="#E8E8E8" FontSize="14" Margin="0,0,0,12" Cursor="Hand">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="OuterCircle" Width="20" Height="20" CornerRadius="10"
                                            BorderBrush="#66BB9A" BorderThickness="2" Background="Transparent">
                                        <Border x:Name="InnerCircle" Width="12" Height="12" CornerRadius="6"
                                                Background="#66BB9A" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="Collapsed"/>
                                    </Border>
                                    <TextBlock Text="{TemplateBinding Content}" Foreground="#E8E8E8" FontSize="14"
                                               Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="InnerCircle" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="OuterCircle" Property="Background" Value="#2066BB9A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>

                    <RadioButton Content="{DynamicResource LangCzech}"
                                 IsChecked="{Binding SelectedLanguage, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static services:AppLanguage.Czech}}"
                                 Foreground="#E8E8E8" FontSize="14" Margin="0,0,0,12" Cursor="Hand">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="OuterCircle" Width="20" Height="20" CornerRadius="10"
                                            BorderBrush="#66BB9A" BorderThickness="2" Background="Transparent">
                                        <Border x:Name="InnerCircle" Width="12" Height="12" CornerRadius="6"
                                                Background="#66BB9A" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="Collapsed"/>
                                    </Border>
                                    <TextBlock Text="{TemplateBinding Content}" Foreground="#E8E8E8" FontSize="14"
                                               Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="InnerCircle" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="OuterCircle" Property="Background" Value="#2066BB9A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>

                    <RadioButton Content="{DynamicResource LangEnglish}"
                                 IsChecked="{Binding SelectedLanguage, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static services:AppLanguage.English}}"
                                 Foreground="#E8E8E8" FontSize="14" Margin="0,0,0,0" Cursor="Hand">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="OuterCircle" Width="20" Height="20" CornerRadius="10"
                                            BorderBrush="#66BB9A" BorderThickness="2" Background="Transparent">
                                        <Border x:Name="InnerCircle" Width="12" Height="12" CornerRadius="6"
                                                Background="#66BB9A" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="Collapsed"/>
                                    </Border>
                                    <TextBlock Text="{TemplateBinding Content}" Foreground="#E8E8E8" FontSize="14"
                                               Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="InnerCircle" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="OuterCircle" Property="Background" Value="#2066BB9A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>