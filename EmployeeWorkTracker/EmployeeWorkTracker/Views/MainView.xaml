<UserControl x:Class="EmployeeWorkTracker.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:EmployeeWorkTracker.ViewModels">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32">
            <StackPanel>
                <TextBlock Text="Главное меню"
                           FontSize="24" FontWeight="Medium"
                           Foreground="#E8E8E8" Margin="0,0,0,24"/>

                <WrapPanel>
                    <!-- Управление сотрудниками -->
                    <Border Background="#252525" CornerRadius="12" Padding="24"
                            Width="300" Height="180" Margin="0,0,16,16"
                            Cursor="Hand" MouseLeftButtonUp="EmployeesCard_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <materialDesign:PackIcon Kind="AccountGroup" Width="32" Height="32" Foreground="#66BB9A"/>
                            <TextBlock Grid.Row="1" Text="Управление сотрудниками" FontSize="16"
                                       FontWeight="Medium" Foreground="#E8E8E8" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Text="Добавление, редактирование и поиск сотрудников"
                                       FontSize="12" Foreground="#A0A0A0" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>

                    <!-- База данных -->
                    <Border Background="#252525" CornerRadius="12" Padding="24"
                            Width="300" Height="180" Margin="0,0,16,16"
                            Cursor="Hand" MouseLeftButtonUp="DatabaseCard_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <materialDesign:PackIcon Kind="Database" Width="32" Height="32" Foreground="#66BB9A"/>
                            <TextBlock Grid.Row="1" Text="База данных" FontSize="16"
                                       FontWeight="Medium" Foreground="#E8E8E8" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Text="Хранение карточек всех сотрудников"
                                       FontSize="12" Foreground="#A0A0A0" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>

                    <!-- Начисление зарплаты -->
                    <Border Background="#252525" CornerRadius="12" Padding="24"
                            Width="300" Height="180" Margin="0,0,16,16"
                            Cursor="Hand" MouseLeftButtonUp="SalaryCard_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <materialDesign:PackIcon Kind="Cash" Width="32" Height="32" Foreground="#66BB9A"/>
                            <TextBlock Grid.Row="1" Text="Начисление зарплаты" FontSize="16"
                                       FontWeight="Medium" Foreground="#E8E8E8" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Text="Начисление зарплаты сотрудникам"
                                       FontSize="12" Foreground="#A0A0A0" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>

                    <!-- Отчёты -->
                    <Border Background="#252525" CornerRadius="12" Padding="24"
                            Width="300" Height="180" Margin="0,0,16,16"
                            Cursor="Hand" MouseLeftButtonUp="ReportsCard_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <materialDesign:PackIcon Kind="ChartBar" Width="32" Height="32" Foreground="#66BB9A"/>
                            <TextBlock Grid.Row="1" Text="Посмотреть отчёты" FontSize="16"
                                       FontWeight="Medium" Foreground="#E8E8E8" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Text="Аналитика и статистика рабочих часов"
                                       FontSize="12" Foreground="#A0A0A0" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>