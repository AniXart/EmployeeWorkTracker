<Window x:Class="EmployeeWorkTracker.Views.FirstRunDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{DynamicResource FirstRunTitle}"
        Width="450" Height="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Border Background="#1A1A1A" BorderBrush="#3E3E3E" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="64"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#1A1A1A" CornerRadius="12,12,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="{DynamicResource FirstRunTitle}" FontSize="14" FontWeight="Medium"
                               Foreground="#E8E8E8" VerticalAlignment="Center" Margin="20,0,0,0"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Padding="32,16">
                <StackPanel>
                    <materialDesign:PackIcon Kind="Language" Width="48" Height="48"
                                             Foreground="#66BB9A" HorizontalAlignment="Center" Margin="0,0,0,16"/>

                    <TextBlock Text="{DynamicResource FirstRunMessage}" FontSize="14"
                               Foreground="#A0A0A0" HorizontalAlignment="Center" Margin="0,0,0,24" TextWrapping="Wrap"/>

                    <RadioButton x:Name="RadioEnglish" Content="{DynamicResource LangEnglish}"
                                 Foreground="#E8E8E8" FontSize="14" Margin="0,0,0,12" Cursor="Hand" IsChecked="True">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="OuterCircle" Width="20" Height="20" CornerRadius="10"
                                            BorderBrush="#66BB9A" BorderThickness="2" Background="Transparent">
                                        <Border x:Name="InnerCircle" Width="12" Height="12" CornerRadius="6"
                                                Background="#66BB9A" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="Collapsed"/>
                                    </Border>
                                    <TextBlock Text="{TemplateBinding Content}" Foreground="#E8E8E8" FontSize="14"
                                               Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="InnerCircle" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="OuterCircle" Property="Background" Value="#2066BB9A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>

                    <RadioButton x:Name="RadioRussian" Content="{DynamicResource LangRussian}"
                                 Foreground="#E8E8E8" FontSize="14" Margin="0,0,0,12" Cursor="Hand">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="OuterCircle" Width="20" Height="20" CornerRadius="10"
                                            BorderBrush="#66BB9A" BorderThickness="2" Background="Transparent">
                                        <Border x:Name="InnerCircle" Width="12" Height="12" CornerRadius="6"
                                                Background="#66BB9A" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="Collapsed"/>
                                    </Border>
                                    <TextBlock Text="{TemplateBinding Content}" Foreground="#E8E8E8" FontSize="14"
                                               Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="InnerCircle" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="OuterCircle" Property="Background" Value="#2066BB9A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>

                    <RadioButton x:Name="RadioUkrainian" Content="{DynamicResource LangUkrainian}"
                                 Foreground="#E8E8E8" FontSize="14" Margin="0,0,0,12" Cursor="Hand">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="OuterCircle" Width="20" Height="20" CornerRadius="10"
                                            BorderBrush="#66BB9A" BorderThickness="2" Background="Transparent">
                                        <Border x:Name="InnerCircle" Width="12" Height="12" CornerRadius="6"
                                                Background="#66BB9A" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="Collapsed"/>
                                    </Border>
                                    <TextBlock Text="{TemplateBinding Content}" Foreground="#E8E8E8" FontSize="14"
                                               Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="InnerCircle" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="OuterCircle" Property="Background" Value="#2066BB9A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>

                    <RadioButton x:Name="RadioCzech" Content="{DynamicResource LangCzech}"
                                 Foreground="#E8E8E8" FontSize="14" Margin="0,0,0,0" Cursor="Hand">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="OuterCircle" Width="20" Height="20" CornerRadius="10"
                                            BorderBrush="#66BB9A" BorderThickness="2" Background="Transparent">
                                        <Border x:Name="InnerCircle" Width="12" Height="12" CornerRadius="6"
                                                Background="#66BB9A" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="Collapsed"/>
                                    </Border>
                                    <TextBlock Text="{TemplateBinding Content}" Foreground="#E8E8E8" FontSize="14"
                                               Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="InnerCircle" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="OuterCircle" Property="Background" Value="#2066BB9A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Background="#252525" BorderBrush="#3E3E3E" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12">
                <Button HorizontalAlignment="Right" Margin="0,0,20,0" Height="40" Width="120"
                        Background="#66BB9A" BorderThickness="0" Cursor="Hand" Click="ContinueButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="#66BB9A" CornerRadius="12">
                                <TextBlock Text="{DynamicResource Continue}" FontSize="13" FontWeight="Medium"
                                           Foreground="#000000" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#5AAE8A"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>
        </Grid>
    </Border>
</Window>